# Set a local database password before starting Compose. Do not commit .env.
POSTGRES_PASSWORD=

# Optional API connection overrides:
# DATABASE_URL=jdbc:postgresql://localhost:5432/wgo
# DATABASE_USERNAME=wgo
# OPENSEARCH_ENDPOINT=http://localhost:9200

# Optional host port overrides:
# POSTGRES_PORT=5432
# LOCALSTACK_PORT=4566
# OPENSEARCH_PORT=9200
# ADMINER_PORT=8081
# OPENSEARCH_DASHBOARDS_PORT=5601
# OPENSEARCH_INDEX=events-v1

# Candidate retrieval defaults:
# MATCHING_TOP_K=20
# MATCHING_MAX_DISTANCE_METERS=10000
# MATCHING_TIME_WINDOW=PT24H
# MATCHING_MINIMUM_SIMILARITY=0.75

# Optional Terraform queue settings (export the root .env before planning):
# TF_VAR_visibility_timeout_seconds=30
# TF_VAR_max_receive_count=5

# Optional application SQS overrides (defaults target local development):
# SQS_ENDPOINT=http://localhost:4566
# OBSERVATION_QUEUE_NAME=observation-processing
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Embeddings (called during observation processing):
# EMBEDDING_PROVIDER=fixed
# EMBEDDING_DIMENSIONS=768
# To use AWS Bedrock instead, set EMBEDDING_PROVIDER=bedrock and configure:
# BEDROCK_INFERENCE_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com

# Optional Claude event categorization (API key stays on the backend):
# CATEGORIZATION_ENABLED=true
# ANTHROPIC_API_KEY=
# CATEGORIZATION_MODEL=claude-haiku-4-5-20251001

# UI settings (Vite reads this root file automatically):
# Vite development proxy destination. Restart Vite after changing this.
API_PROXY_TARGET=http://localhost:8080

# Public browser setting. Must point to a MapLibre style JSON URL.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional on-demand Claude titles and summaries (uses ANTHROPIC_API_KEY above):
# SUMMARIZATION_ENABLED=true
# SUMMARIZATION_MODEL=claude-haiku-4-5-20251001

# Saved event summaries and shared cache:
# EVENT_ACTIVE_WINDOW=PT24H
# SUMMARY_REFRESH_INTERVAL=PT15M
# SUMMARY_CACHE_TTL=PT24H
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_INSIGHT_PORT=5540
# REDIS_PASSWORD=
