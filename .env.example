# Set a local database password before starting Compose. Do not commit .env.
POSTGRES_PASSWORD=

# Optional host port overrides:
# POSTGRES_PORT=5432
# LOCALSTACK_PORT=4566
# OPENSEARCH_PORT=9200
# ADMINER_PORT=8081
# OPENSEARCH_DASHBOARDS_PORT=5601
# OPENSEARCH_INDEX=events-v1

# Candidate retrieval defaults:
# MATCHING_TOP_K=20
# MATCHING_MAX_DISTANCE_METERS=10000
# MATCHING_TIME_WINDOW=PT24H
# MATCHING_MINIMUM_SIMILARITY=0.75

# Queue settings are Terraform variables in infra/terraform.

# Optional application SQS overrides (defaults target local development):
# SQS_ENDPOINT=http://localhost:4566
# OBSERVATION_QUEUE_NAME=observation-processing
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Embeddings (called by the future processor, not the ingestion endpoint):
# EMBEDDING_PROVIDER=fixed
# EMBEDDING_DIMENSIONS=768
# To use AWS Bedrock instead, set EMBEDDING_PROVIDER=bedrock and configure:
# BEDROCK_INFERENCE_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_ENDPOINT=https://bedrock-runtime.us-east-1.amazonaws.com
